// Japeans data model (skeleton). See docs/PLAN.md for the module map.
// Dictionary tables are filled by import scripts (JMdict, KANJIDIC2, KRADFILE, KanjiVG, Tatoeba).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Module A/B: Dictionary ─────────────

// id = JMdict ent_seq, so imports are idempotent and URLs are stable.
model Word {
  id         Int             @id
  jlptLevel  Int? // 5 = N5 … 1 = N1 (not in JMdict; filled later)
  isCommon   Boolean         @default(false)
  kanjiForms WordKanjiForm[]
  readings   WordReading[]
  senses     Sense[]
  examples   WordExample[]
  setCards   SetCard[]

  @@index([jlptLevel])
}

model WordKanjiForm {
  id       Int      @id @default(autoincrement())
  wordId   Int
  word     Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  order    Int
  text     String // e.g. 勉強
  isCommon Boolean  @default(false)
  tags     String[] // JMdict tags: iK, ateji, rK…

  @@index([text])
  @@index([wordId])
}

model WordReading {
  id             Int      @id @default(autoincrement())
  wordId         Int
  word           Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  order          Int
  kana           String // e.g. べんきょう
  romaji         String
  isCommon       Boolean  @default(false)
  tags           String[]
  appliesToKanji String[] // ["*"] = all kanji forms
  pitch          String? // pitch accent pattern

  @@index([kana])
  @@index([romaji])
  @@index([wordId])
}

model Sense {
  id            Int      @id @default(autoincrement())
  wordId        Int
  word          Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  order         Int
  partsOfSpeech String[] // JMdict tag codes: n, vs, v5u…
  misc          String[] // uk, abbr, hon…
  fields        String[] // comp, med…
  info          String[]
  related       String[] // display text of related entries
  antonyms      String[]
  glossEn       String[]
  glossVi       String[] // Vietnamese meanings (AI-translated, then reviewed)
  viReviewed    Boolean  @default(false)

  @@index([wordId])
}

// id = Tatoeba sentence id.
model Example {
  id         Int           @id
  textJa     String
  furigana   String? // ruby markup
  textVi     String?
  textEn     String?
  difficulty Int? // 1..5
  words      WordExample[]
}

model WordExample {
  wordId     Int
  exampleId  Int
  senseOrder Int // which sense of the word this sentence illustrates
  form       String // the form of the word used in the sentence
  word       Word    @relation(fields: [wordId], references: [id], onDelete: Cascade)
  example    Example @relation(fields: [exampleId], references: [id], onDelete: Cascade)

  @@id([wordId, exampleId])
  @@index([exampleId])
}

// ───────────── Module C: Kanji & radicals ─────────────

// id = Unicode code point.
model Kanji {
  id            Int              @id
  character     String           @unique // 学
  onReadings    String[]
  kunReadings   String[]
  nanori        String[]
  hanViet       String[] // HỌC (KANJIDIC2 "vietnam", fallback Unihan kVietnamese)
  meaningsEn    String[]
  meaningsVi    String[]
  strokeCount   Int
  jlptOld       Int? // KANJIDIC2 pre-2010 JLPT level 1..4
  jlptLevel     Int? // N-level, filled later
  grade         Int? // school grade (1–6, 8 = secondary, 9–10 = jinmeiyō)
  frequency     Int? // newspaper frequency rank 1..2500
  kangxiRadical Int? // classical radical number 1..214
  radicalId     Int?
  radical       Radical?         @relation("classical", fields: [radicalId], references: [id])
  strokeSvg     String? // KanjiVG stroke paths (JSON array of path d strings)
  components    KanjiComponent[]

  @@index([jlptOld])
  @@index([grade])
  @@index([frequency])
}

// Union of the 214 Kangxi radicals and the RADKFILE components.
model Radical {
  id          Int              @id
  character   String           @unique // RADKFILE character (may be a stand-in, e.g. 扎)
  display     String // what to show (扎 → 扌)
  kangxiNo    Int?             @unique // 1..214
  strokeCount Int
  hanViet     String? // NHÂN
  nameVi      String? // nhân đứng (editorial)
  meaningEn   String?
  meaningVi   String?
  kanji       Kanji[]          @relation("classical")
  usedIn      KanjiComponent[]
}

// Decomposition from KRADFILE — ground truth, never AI-generated.
model KanjiComponent {
  kanjiId   Int
  radicalId Int
  position  Int
  kanji     Kanji   @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  radical   Radical @relation(fields: [radicalId], references: [id], onDelete: Cascade)

  @@id([kanjiId, radicalId])
  @@index([radicalId])
}

// Cached AI output (mnemonics, nuance explanations) with review status.
model AIContent {
  id        Int             @id @default(autoincrement())
  type      AIContentType
  targetKey String // e.g. "kanji:学" or "word:123"
  content   String
  model     String
  status    AIContentStatus @default(PENDING)
  reports   Report[]
  createdAt DateTime        @default(now())

  @@unique([type, targetKey])
}

enum AIContentType {
  // Vietnamese meanings for a word; targetKey "word:<id>", content JSON {senses: [{order, vi: string[]}]}.
  // Kept here (not only in Sense.glossVi) so re-importing JMdict does not lose paid translations.
  WORD_GLOSS_VI
  KANJI_MNEMONIC
  KANJI_EXPLANATION
  WORD_USAGE
  WORD_COMPARISON
}

enum AIContentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Report {
  id          Int        @id @default(autoincrement())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
  aiContentId Int?
  aiContent   AIContent? @relation(fields: [aiContentId], references: [id])
  studySetId  String?
  studySet    StudySet?  @relation(fields: [studySetId], references: [id])
  reason      String
  resolved    Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

// ───────────── Users ─────────────

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole       @default(LEARNER)
  dailyGoal     Int            @default(20)
  streak        Int            @default(0)
  xp            Int            @default(0)
  accounts      Account[]
  authSessions  Session[]
  studySets     StudySet[]
  folders       Folder[]
  progress      CardProgress[]
  reviewLogs    ReviewLog[]
  studySessions StudySession[]
  reports       Report[]
  createdAt     DateTime       @default(now())
}

// ── Sign-in (next-auth 4 + @next-auth/prisma-adapter). Field names are fixed by the adapter. ──

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  LEARNER
  TEACHER
  EDITOR
  ADMIN
}

// ───────────── Module D + H: Study sets (Quizlet-style) & SRS ─────────────

model StudySet {
  id          String         @id @default(cuid())
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  visibility  Visibility     @default(PRIVATE)
  tags        String[]
  isOfficial  Boolean        @default(false) // built-in JLPT decks
  cloneOfId   String?
  cloneOf     StudySet?      @relation("clones", fields: [cloneOfId], references: [id])
  clones      StudySet[]     @relation("clones")
  cards       SetCard[]
  folders     FolderSet[]
  sessions    StudySession[]
  reports     Report[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([visibility])
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

model SetCard {
  id         String         @id @default(cuid())
  setId      String
  set        StudySet       @relation(fields: [setId], references: [id], onDelete: Cascade)
  order      Int
  term       String
  reading    String?
  definition String
  imageUrl   String?
  audioUrl   String?
  wordId     Int? // optional link to the dictionary
  word       Word?          @relation(fields: [wordId], references: [id])
  progress   CardProgress[]
  reviewLogs ReviewLog[]

  @@index([setId, order])
}

model Folder {
  id      String      @id @default(cuid())
  ownerId String
  owner   User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name    String
  sets    FolderSet[]
}

model FolderSet {
  folderId String
  setId    String
  folder   Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  set      StudySet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@id([folderId, setId])
}

// FSRS scheduling state per user per card.
model CardProgress {
  userId     String
  cardId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card       SetCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  starred    Boolean   @default(false)
  inSrs      Boolean   @default(false)
  state      Int       @default(0) // 0 new, 1 learning, 2 review, 3 relearning
  stability  Float     @default(0)
  difficulty Float     @default(0)
  reps       Int       @default(0)
  lapses     Int       @default(0)
  due        DateTime  @default(now())
  lastReview DateTime?

  @@id([userId, cardId])
  @@index([userId, due])
}

model ReviewLog {
  id        String    @id @default(cuid())
  userId    String
  cardId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card      SetCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  mode      StudyMode
  rating    Int // FSRS: 1 again, 2 hard, 3 good, 4 easy
  correct   Boolean
  elapsedMs Int?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model StudySession {
  id         String    @id @default(cuid())
  userId     String
  setId      String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  set        StudySet  @relation(fields: [setId], references: [id], onDelete: Cascade)
  mode       StudyMode
  score      Int?
  durationMs Int?
  createdAt  DateTime  @default(now())
}

enum StudyMode {
  FLASHCARD
  LEARN
  WRITE
  DICTATION
  HANDWRITING
  TEST
  MATCH
  SRS_REVIEW
}
