# Copy to .env and adjust. Values below match docker-compose.yml (dev only).
DATABASE_URL="postgresql://japeans:japeans_dev@localhost:5432/japeans?schema=public"
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="japeans_dev_master_key"
REDIS_URL="redis://localhost:6379"

# AI (kanji mnemonics, usage explanations). Leave empty until needed.
ANTHROPIC_API_KEY=""

# Claude model for AI translation / mnemonics (see src/lib/translation.ts MODEL_PRICES)
JAPEANS_AI_MODEL="claude-opus-5-5"

# Sign-in (next-auth 4 + Google). Create an OAuth client at console.cloud.google.com
# with redirect URI http://localhost:3000/api/auth/callback/google. Leave empty to disable sign-in.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""      # e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
